{
  "manifest_version": 3,
  "name": "html.cloud — share local HTML",
  "version": "0.1.0",
  "description": "Open a local HTML file and share it as a zero-knowledge encrypted link in one click. Encryption happens in your browser; the server only ever sees ciphertext.",
  "permissions": ["storage", "clipboardWrite"],
  "host_permissions": ["https://html.cloud/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["file:///*.html", "file:///*.htm"],
      "js": ["content-file.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://html.cloud/*"],
      "js": ["content-merge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Share this HTML file to html.cloud",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "onboarding.html",
  "web_accessible_resources": [
    {
      "resources": ["vendor/*.js"],
      "matches": ["file:///*", "https://html.cloud/*"]
    }
  ]
}
